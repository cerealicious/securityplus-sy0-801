{
  "name": "securityplus-sy0-801",
  "productName": "Security+ SY0-801",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme d'apprentissage interactive pour CompTIA Security+ SY0-801",
  "author": "Security+ SY0-801 Learning Platform",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "preview:app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.secplus.sy0801",
    "productName": "Security+ SY0-801",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "SecurityPlus-SY0-801-Portable-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "compression": "maximum"
  }
}
